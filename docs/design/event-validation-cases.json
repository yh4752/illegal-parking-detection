  "stateful_scenarios": [
    {
      "id": "DB01",
      "input": "same device_id/message_id and same canonical payload after STORED",
      "expect": "DUPLICATE; no extra state update or retention extension"
    },
    {
      "id": "DB02",
      "input": "same device_id/message_id with different canonical payload",
      "expect": "separate quarantine committed, REJECTED/MESSAGE_ID_CONFLICT; original receipt preserved"
    },
    {
      "id": "DB03",
      "input": "same rejected message resent unchanged",
      "expect": "original REJECTED/error_code; never successful DUPLICATE"
    },
    {
      "id": "DB04",
      "input": "seq 12 followed by new message_id seq 10",
      "expect": "history may be stored; device snapshot not regressed; incident ordering evaluated separately"
    },
    {
      "id": "DB05",
      "input": "closed incident followed by a newer nonterminal summary",
      "expect": "quarantine; no incident reopening or partial snapshot update"
    },
    {
      "id": "DB06",
      "input": "newer summary decreases guidance_count on same incident",
      "expect": "quarantine; existing count preserved"
    },
    {
      "id": "DB07",
      "input": "referenced policy absent from zone_policy",
      "expect": "quarantine then REJECTED/VERSION_CONFLICT; do not create guessed policy"
    },
    {
      "id": "DB08",
      "input": "DB or quarantine commit fails",
      "expect": "no application ACK; transaction rolled back"
    },
    {
      "id": "DB09",
      "input": "commit succeeds but ACK is lost; same payload resent",
      "expect": "DUPLICATE without repeating effects"
    },
    {
      "id": "DB10",
      "input": "first state update while revision range remains 0",
      "expect": "reserve valid range per D6 before state commit; do not bypass constraint"
    },
    {
      "id": "DB11",
      "input": "history is replayed without a fresh heartbeat",
      "expect": "connection_state and last_heartbeat_at unchanged"
    },
    {
      "id": "DB12",
      "input": "snapshot current incident absent in incident but full current summary provided",
      "expect": "apply C9 summary projection; preserve unknown timestamps as null; do not manufacture times"
    }
  ]
}
